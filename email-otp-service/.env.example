NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/otp.sqlite
OTP_SECRET=replace_with_a_long_random_secret
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FALLBACK_PORT=465
SMTP_FALLBACK_SECURE=true
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM_NAME=Your Site Name
